# Configuration template only. Never put tickets, proofs, TLS private keys, or
# control-plane credentials in this file.
RELAY_ENVIRONMENT=development
RELAY_LISTEN_ADDR=:8443
RELAY_TLS_CERT_FILE=./.local/tls/relay.pem
RELAY_TLS_KEY_FILE=./.local/tls/relay-key.pem
RELAY_DEV_ACCEPT_TICKETS=true
RELAY_ALLOW_MEMORY_STORE=true
RELAY_DRAIN_TIMEOUT=30s
RELAY_LOG_LEVEL=info
RELAY_MAX_STREAMS=8
RELAY_MAX_DESKTOP_CHANNELS=10000
RELAY_MAX_DESKTOP_ATTEMPTS_PER_MINUTE=10
RELAY_MAX_MOBILE_OPENS_PER_MINUTE=30
RELAY_MAX_SOURCE_OPENS_PER_MINUTE=120
